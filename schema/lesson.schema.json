{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/duclun/sketchboard-lessons/schema/lesson.schema.json",
  "title": "Sketchboard lesson",
  "description": "A pencil-sketch lesson: ordered steps, each narrated by `say` while its `do` actions are drawn on a 400x500 board (origin top-left, y down). See docs/lesson-format.md.",
  "type": "object",
  "required": [
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "description": "Planning data, ignored by the player.",
      "properties": {
        "subject": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "objective": {
          "type": "string",
          "description": "What the student can do afterwards, one sentence."
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Chapter name, under ~28 chars"
        },
        "say": {
          "type": "string",
          "description": "Narration caption, 8-25 words. 0.34 s per word."
        },
        "do": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "description": "Extra seconds after the step, default 0.25"
        },
        "pause": {
          "type": "boolean",
          "description": "Stop at the end of this step until the student presses Continue"
        },
        "audio": {
          "type": "object",
          "description": "Narration recording for this step, stamped by tools/narrate.mjs",
          "properties": {
            "src": { "type": "string" },
            "dur": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["src", "dur"],
          "additionalProperties": false
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "description": "Hand-drawn segment",
          "properties": {
            "op": {
              "const": "line"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Polyline; close:true joins back to the first point",
          "properties": {
            "op": {
              "const": "poly"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "pts": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "close": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "pts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Rectangle outline, x,y = top-left",
          "properties": {
            "op": {
              "const": "rect"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "x",
            "y",
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Circle outline",
          "properties": {
            "op": {
              "const": "circle"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "r": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "cx",
            "cy",
            "r"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Any SVG path in board coordinates, drawn as given",
          "properties": {
            "op": {
              "const": "path"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "d": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "op",
            "d"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Written text; y is the baseline",
          "properties": {
            "op": {
              "const": "text"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "t": {
              "type": [
                "string",
                "number"
              ]
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "size": {
              "type": "number",
              "minimum": 6
            },
            "anchor": {
              "enum": [
                "start",
                "middle",
                "end"
              ]
            },
            "font": {
              "enum": [
                "display",
                "mono",
                "hand"
              ]
            }
          },
          "required": [
            "op",
            "t",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Scribble fill inside a shape (no outline). Painted under strokes of the current scene.",
          "properties": {
            "op": {
              "const": "fill"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "of": {
              "enum": [
                "rect",
                "poly",
                "circle"
              ]
            },
            "a": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            },
            "pts": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "close": {
              "type": "boolean"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "r": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "of"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Pan/zoom: center board point x,y at zoom s. No keys = reset to full view.",
          "properties": {
            "op": {
              "const": "cam"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Fade out everything drawn so far and start a fresh page",
          "properties": {
            "op": {
              "const": "clear"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Wait s seconds (default 0.5)",
          "properties": {
            "op": {
              "const": "hold"
            },
            "color": {
              "type": "string",
              "description": "Palette name (ink blue orange green red yellow brown purple teal grey soft paper) or hex like #2f5fd0",
              "pattern": "^(ink|blue|orange|green|red|yellow|brown|purple|teal|grey|soft|paper|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
            },
            "lw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stroke width, default 2.2"
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Override duration in seconds"
            },
            "note": {
              "type": "string"
            },
            "s": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
